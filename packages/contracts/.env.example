# Private key of the deployer account. Use a throwaway Fuji-only key and
# never commit the real value. Leave empty to keep every deployment script
# blocked: no key means no signer, and no script falls back to a node account.
DEPLOYER_PRIVATE_KEY=

# Avalanche Fuji C-Chain RPC. An API key embedded in the path is fine; the
# scripts only ever print the host, never the full URL.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Address that receives DEFAULT_ADMIN_ROLE. Defaults to the deployer when
# empty. Set this to a separate key (ideally a multisig) if the deployer is a
# hot wallet; role initialisation must then be run with the admin key.
REGISTRY_ADMIN_ADDRESS=

# Comma-separated addresses that receive REGISTRAR_ROLE at initialisation.
REGISTRAR_ADDRESSES=

# Comma-separated addresses that receive FINANCIER_ROLE at initialisation.
FINANCIER_ADDRESSES=

# Required for any non-local deployment. Must match "<network>:<chainId>"
# exactly, e.g. CONFIRM_DEPLOY=fuji:43113
CONFIRM_DEPLOY=
