# --- Runtime ---
NODE_ENV=development
API_PORT=3001

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL ---
# Matches docker-compose.yml defaults. Change both together.
DATABASE_URL=postgresql://veritrade:veritrade@localhost:5432/veritrade

# --- Authentication ---
# Signing secret for access tokens. At least 32 characters.
# Generate with: openssl rand -base64 48
# Changing this invalidates every issued token.
JWT_SECRET=change-me-to-at-least-32-random-characters
# Access token lifetime in seconds. Minimum 60.
JWT_EXPIRES_IN_SECONDS=3600
# Self-service registration. Defaults to true outside production and false in
# production, so an accidentally public signup endpoint is opt-in, not default.
AUTH_ALLOW_REGISTRATION=true

# --- Invoice documents ---
# Where uploaded XML is stored. Relative paths resolve against the API's
# working directory. Git-ignored: these files contain buyer and seller names
# and tax ids. See docs/invoice-security.md before pointing this at a shared
# volume.
INVOICE_STORAGE_DIR=var/invoices
# Upload ceiling in bytes (1024 - 20971520). Also the size the parser enforces
# and the limit multer applies to the request stream.
INVOICE_MAX_UPLOAD_BYTES=2097152

# --- Avalanche (C-Chain) ---
# 43113 = Fuji testnet, 31337 = a local Hardhat node. Anything else, including
# mainnet 43114, is rejected at boot.
AVALANCHE_CHAIN_ID=43113
# Must be https://. http:// is accepted only on chain 31337.
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Address of the deployed VeriTradeInvoiceRegistry. Filled in after a deploy.
# Leave empty and the chain endpoints answer 503 BLOCKCHAIN_NOT_CONFIGURED.
VERITRADE_CONTRACT_ADDRESS=
# Runtime signer for chain writes. 0x + 64 hex. Leave empty and the chain
# endpoints are read-only: reads work, every write answers 503.
# This is NOT the same variable the deploy script reads (DEPLOYER_PRIVATE_KEY
# in packages/contracts/.env). Never commit a real key, never put one behind
# a NEXT_PUBLIC_ prefix.
AVALANCHE_DEPLOYER_PRIVATE_KEY=
# Blocks to wait after a receipt before treating a write as final (1-64).
# 1 is right for a local node; a testnet wants more.
BLOCKCHAIN_CONFIRMATIONS=1
# Event indexer poll interval in ms. 0 (the default) disables the poller; the
# indexer also stays idle when no contract address is configured.
BLOCKCHAIN_INDEXER_INTERVAL_MS=0
