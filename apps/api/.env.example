# --- Runtime ---
NODE_ENV=development
API_PORT=3001

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL ---
# Matches docker-compose.yml defaults. Change both together.
DATABASE_URL=postgresql://veritrade:veritrade@localhost:5432/veritrade

# --- Avalanche Fuji Testnet (C-Chain) ---
AVALANCHE_CHAIN_ID=43113
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Address of the deployed VeriTrade contract. Filled in after `pnpm deploy:fuji`.
VERITRADE_CONTRACT_ADDRESS=
