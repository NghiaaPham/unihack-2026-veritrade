# Base URL of the VeriTrade API. Exposed to the browser, so no secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Avalanche Fuji Testnet (C-Chain) ---
NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Filled in after `pnpm deploy:fuji`.
NEXT_PUBLIC_VERITRADE_CONTRACT_ADDRESS=

# --- Optional same-origin proxy (server-side, see next.config.ts) ---
# Use when the browser cannot reach the API/RPC directly; then set NEXT_PUBLIC_API_URL=
# (empty) and NEXT_PUBLIC_RPC_URL=/rpc.
# API_PROXY_TARGET=http://127.0.0.1:3001
# RPC_PROXY_TARGET=http://127.0.0.1:8545
